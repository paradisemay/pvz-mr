  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\u041A\u0410\u041A \u0418\u0413\u0420\u0410\u0422\u042C</b>\n1. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435
    \u0441\u043A\u0430\u043D\u0435\u0440 \u0441\u043E \u0441\u0442\u043E\u0439\u043A\u0438\n2.
    \u041A\u043B\u0438\u0435\u043D\u0442 \u043F\u043E\u043A\u0430\u0436\u0435\u0442
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u2014 \u043E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
    \u043A\u043E\u0434\n3. \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0443
    \u0441\u043A\u0430\u043D\u0435\u0440\u043E\u043C\n4. \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435
    \u0435\u0451 \u0432 \u0437\u0435\u043B\u0451\u043D\u0443\u044E \u0437\u043E\u043D\u0443\n5.
    \u041F\u0440\u043E\u0441\u044F\u0442 \u043F\u0430\u043A\u0435\u0442 \u2014 \u043F\u0430\u043A\u0435\u0442
    \u0441\u043E \u0441\u0442\u043E\u0439\u043A\u0438 \u0432 \u0437\u043E\u043D\u0443\n6.
    \u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u2014 \u043E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
    \u043A\u043E\u0440\u043E\u0431\u043A\u0443 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\n7.
    \u041F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u2014 \u043E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
    \u043D\u043E\u0432\u044B\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0438\n<size=80%>\u0412\u0437\u044F\u0442\u044C
    \u2014 \u043A\u043D\u043E\u043F\u043A\u0430 \u0437\u0430\u0445\u0432\u0430\u0442\u0430,
    \u0441\u043A\u0430\u043D \u2014 \u043A\u0443\u0440\u043E\u043A</size>"
